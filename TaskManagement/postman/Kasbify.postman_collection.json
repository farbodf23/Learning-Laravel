{
  "info": {
    "name": "Kasbify - Task Management API",
    "description": "Postman collection for demonstrating the Kasbify task management API. Import the matching Kasbify Local environment, enter the seeded account credentials, and run requests in the suggested order. The collection uses the API contract documented in docs/openapi.yaml and checks the standard Persian error envelope on every failed response. Run Logout - Manager last.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{manager_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "    pm.test('API errors use the Persian error envelope', function () {",
          "        const body = pm.response.json();",
          "        pm.expect(body).to.have.property('error');",
          "        pm.expect(body.error.code).to.be.a('string');",
          "        pm.expect(body.error.message).to.match(/[\\u0600-\\u06FF]/);",
          "        const expectedCodes = {",
          "            400: 'BAD_REQUEST',",
          "            401: 'UNAUTHENTICATED',",
          "            403: 'FORBIDDEN',",
          "            404: 'NOT_FOUND',",
          "            405: 'METHOD_NOT_ALLOWED',",
          "            409: 'CONFLICT',",
          "            419: 'CSRF_TOKEN_MISMATCH',",
          "            422: 'VALIDATION_ERROR',",
          "            429: 'TOO_MANY_REQUESTS'",
          "        };",
          "        if (expectedCodes[pm.response.code]) {",
          "            pm.expect(body.error.code).to.eql(expectedCodes[pm.response.code]);",
          "        }",
          "        if (pm.response.code === 422) {",
          "            pm.expect(body.error.fields).to.be.an('object').and.not.an('array');",
          "            Object.values(body.error.fields).forEach(function (messages) {",
          "                pm.expect(messages).to.be.an('array').that.is.not.empty;",
          "                messages.forEach(function (message) {",
          "                    pm.expect(message).to.match(/[\\u0600-\\u06FF]/);",
          "                });",
          "            });",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "store_id",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    },
    {
      "key": "assigned_user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "description": "Run both login requests first. Tokens are stored separately so manager and staff requests can be run without overwriting each other's credentials.",
      "item": [
        {
          "name": "Login - Manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Logs in as the seeded manager and saves the returned token as manager_token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{manager_email}}\",\n  \"password\": \"{{manager_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Login response contains a token and user', function () {",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.have.property('token');",
                  "    pm.expect(json.data).to.have.property('user');",
                  "});",
                  "pm.environment.set('manager_token', json.data.token);",
                  "pm.environment.set('manager_user_id', String(json.data.user.id));"
                ]
              }
            }
          ]
        },
