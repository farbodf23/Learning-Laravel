{
  "info": {
    "name": "Kasbify - Task Management API",
    "description": "Postman collection for demonstrating the Kasbify task management API. Import the matching Kasbify Local environment, enter the seeded account credentials, and run requests in the suggested order. The collection uses the API contract documented in docs/openapi.yaml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{manager_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "store_id",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    },
    {
      "key": "assigned_user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "description": "Run both login requests first. Tokens are stored separately so manager and staff requests can be run without overwriting each other's credentials.",
      "item": [
        {
          "name": "Login - Manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Logs in as the seeded manager and saves the returned token as manager_token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{manager_email}}\",\n  \"password\": \"{{manager_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Login response contains a token and user', function () {",
                  "    pm.expect(json).to.have.property('data');",
                  "    pm.expect(json.data).to.have.property('token');",
                  "    pm.expect(json.data).to.have.property('user');",
                  "});",
                  "pm.environment.set('manager_token', json.data.token);",
                  "pm.environment.set('manager_user_id', String(json.data.user.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User - Manager",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/me",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Stores - Manager",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/me/stores",
            "description": "If store_id is empty, saves the first returned store ID. You can also set store_id manually.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Store memberships are returned', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});",
                  "if (!pm.environment.get('store_id') && json.data.length > 0) {",
                  "    pm.environment.set('store_id', String(json.data[0].store_id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "Logs in as a seeded staff member and saves staff_token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staff_email}}\",\n  \"password\": \"{{staff_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Login response contains a token and user', function () {",
                  "    pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('staff_token', json.data.token);",
                  "pm.environment.set('staff_user_id', String(json.data.user.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User - Staff",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/me",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Store Management (Manager)",
      "description": "",
      "item": [
        {
          "name": "List Store Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/stores/{{store_id}}/members",
            "description": "Also saves the first staff member's user ID as assigned_user_id.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Store members are returned', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});",
                  "const staff = json.data.find(member => member.role === 'staff');",
                  "if (staff) pm.environment.set('assigned_user_id', String(staff.user_id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/stores/{{store_id}}/task-summary",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Tasks (Manager)",
      "description": "",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/stores/{{store_id}}/tasks",
            "description": "Creates a task and automatically stores its ID in task_id.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman demo task\",\n  \"description\": \"A task created during the Kasbify API demonstration.\",\n  \"priority\": \"high\",\n  \"due_at\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Created task has an ID', function () {",
                  "    pm.expect(json.data.id).to.exist;",
                  "});",
                  "pm.environment.set('task_id', String(json.data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/stores/{{store_id}}/tasks?page=1&per_page=20",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks - Filtered",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/stores/{{store_id}}/tasks?status=todo&priority=high&page=1&per_page=20",
            "description": "Demonstrates AND-combined task filters.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/stores/{{store_id}}/tasks/{{task_id}}",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Task response has the expected data envelope', function () {",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    pm.expect(json.data.id).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task Details",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/stores/{{store_id}}/tasks/{{task_id}}",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated during the Kasbify Postman demonstration.\",\n  \"priority\": \"medium\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
